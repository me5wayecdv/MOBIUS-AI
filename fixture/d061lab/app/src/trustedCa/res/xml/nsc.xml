<?xml version="1.0" encoding="utf-8"?>
<!-- trustedCa flavor: fixture-specific trust of the Mobius test CA for the
     lab hostname only. Normal hostname verification is preserved; this adds
     no system-wide trust and bypasses nothing for any other app or domain. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">lab.mobius.local</domain>
        <trust-anchors>
            <certificates src="@raw/mobius_test_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
