# Proposed, deliberately outside .github/workflows. No automatic execution.
name: D061 isolated native slice
on:
  workflow_dispatch:
    inputs:
      mode:
        type: choice
        options: [install_only, positive_fixture]
        default: install_only
        required: true
      reviewed_sha:
        description: Exact reviewed commit SHA, must equal executing checkout
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: d061-isolated-native
  cancel-in-progress: false
jobs:
  isolated:
    runs-on: ubuntu-24.04
    timeout-minutes: 18
    env:
      D061_MODE: ${{ inputs.mode }}
      D061_REVIEWED_SHA: ${{ inputs.reviewed_sha }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12'
          cache: ''
      - name: Verify exact source and independently held mode gates
        shell: bash
        run: |
          python - <<'PY'
          import ast, os, re, subprocess
          from pathlib import Path
          expected=os.environ['D061_REVIEWED_SHA']
          actual=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
          if not re.fullmatch('[0-9a-f]{40}',expected) or expected!=actual:
              raise SystemExit('exact reviewed SHA mismatch')
          values={}
          for node in ast.parse(Path('research/d061_native/activate.py').read_text()).body:
              if isinstance(node,ast.Assign) and isinstance(node.value,ast.Constant):
                  for target in node.targets:
                      if isinstance(target,ast.Name):values[target.id]=node.value.value
          if values.get('ALLOW_INSTALL_ONLY') is not True:raise SystemExit('install mode still held')
          if os.environ['D061_MODE']=='positive_fixture' and values.get('ALLOW_POSITIVE_FIXTURE') is not True:
              raise SystemExit('positive runtime still held')
          PY
      - name: Stage locked wheels only, no imports or installation
        run: python research/d061_native/stage_wheels.py "$RUNNER_TEMP/d061-wheels"
      - name: Run exact selected reviewed mode
        id: mode
        shell: bash
        run: |
          set +e
          sudo --preserve-env=ImageOS,ImageVersion,D061_REVIEWED_SHA \
            "$(command -v python)" research/d061_native/activate.py \
            "$D061_MODE" "$RUNNER_TEMP/d061-raw" "$RUNNER_TEMP/d061-wheels"
          rc=$?
          printf '%s\n' "$rc" > "$RUNNER_TEMP/d061-command-rc"
          printf 'command_rc=%s\n' "$rc" >> "$GITHUB_OUTPUT"
          exit "$rc"
      - name: Identity-scoped emergency cleanup, even on timeout or cancellation
        if: always()
        shell: bash
        run: |
          sudo "$(command -v python)" research/d061_native/emergency.py "$RUNNER_TEMP/d061-raw"
      - name: Collect only allowlisted sanitized evidence even on failure
        if: always()
        shell: bash
        run: |
          rc=125
          if test -f "$RUNNER_TEMP/d061-command-rc"; then rc=$(cat "$RUNNER_TEMP/d061-command-rc"); fi
          sudo "$(command -v python)" research/d061_native/collect.py \
            "$RUNNER_TEMP/d061-raw" "$RUNNER_TEMP/d061-safe" "$rc"
      - name: Upload sanitized evidence, never raw directories or homes
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: d061-native-${{ inputs.mode }}-${{ github.run_id }}
          path: ${{ runner.temp }}/d061-safe/
          if-no-files-found: error
          retention-days: 7
